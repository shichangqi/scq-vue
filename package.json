{
  "name": "scq-vue",
  "version": "1.2.1",
  "description": "A Vue 3 component library made by Chauncy",
  "main": "./dist/scq-vue.umd.js",
  "module": "./dist/scq-vue.es.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/scq-vue.es.js",
      "require": "./dist/scq-vue.umd.js"
    },
    "./components/*": {
      "types": "./dist/types/components/*/index.d.ts",
      "import": "./dist/components/*/index.mjs",
      "default": "./dist/components/*/index.mjs"
    },
    "./style.css": "./dist/style.css",
    "./styles/index.css": "./dist/style.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/button.css": "./dist/styles/button.css",
    "./styles/input.css": "./dist/styles/input.css",
    "./styles/icon.css": "./dist/styles/icon.css",
    "./styles/chat-message.css": "./dist/styles/chat-message.css",
    "./styles/chat-choice.css": "./dist/styles/chat-choice.css",
    "./styles/dialog.css": "./dist/styles/dialog.css",
    "./styles/modal.css": "./dist/styles/modal.css",
    "./styles/message.css": "./dist/styles/message.css",
    "./styles/popup.css": "./dist/styles/popup.css",
    "./styles/radio.css": "./dist/styles/radio.css",
    "./styles/checkbox.css": "./dist/styles/checkbox.css",
    "./styles/watermark.css": "./dist/styles/watermark.css",
    "./styles/select.css": "./dist/styles/select.css",
    "./styles/*.css": "./dist/styles/*.css"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && vite build && vite build --config vite.components.config.mjs && vue-tsc -p tsconfig.build.json && pnpm run check:package",
    "dev": "vite",
    "dev:play": "vite --config playground/vite.config.mjs",
    "build:play": "vite build --config playground/vite.config.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:play": "vue-tsc --noEmit -p playground/tsconfig.json",
    "check:package": "node scripts/check-package.mjs",
    "check": "pnpm run typecheck && pnpm run typecheck:play && pnpm test && pnpm run build && pnpm run build:play",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run"
  },
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "button",
    "input",
    "scq-vue",
    "watermark"
  ],
  "author": "Chauncy",
  "license": "ISC",
  "packageManager": "pnpm@10.33.3",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "async-validator": "^4.2.5",
    "date-fns": "^4.4.0",
    "embla-carousel-vue": "^8.6.0",
    "focus-trap": "^8.2.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^25.0.1",
    "rimraf": "^6.0.1",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  }
}
